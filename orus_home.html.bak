<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BIR ORUS 2.0 - Official Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background-color: #ffffff;
            color: #1e293b;
        }

        .bir-gradient-overlay {
            background: linear-gradient(105deg, rgba(144, 43, 43, 0.85) 0%, rgba(3, 41, 123, 0.9) 100%);
        }

        .hero-bg {
            background-image: url('bg.png');
            background-size: cover;
            background-position: center;
        }

        .card-shadow {
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }

        .card-shadow:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
        }

        /* Logic for arrows in "How It Works" */
        .step-card {
            position: relative;
        }

        @media (min-width: 1024px) {
            .step-card:not(:last-child)::after {
                content: '';
                position: absolute;
                right: -24px;
                top: 50%;
                width: 20px;
                height: 2px;
                background-color: #e2e8f0;
            }

            .step-card:not(:last-child)::before {
                content: '';
                position: absolute;
                right: -24px;
                top: 50%;
                margin-top: -4px;
                border-top: 5px solid transparent;
                border-bottom: 5px solid transparent;
                border-left: 6px solid #e2e8f0;
            }
        }

        .page-transition {
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

        .hidden-page {
            display: none;
            opacity: 0;
            transform: translateY(8px);
        }

        .active-page {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>

<body class="min-h-screen flex flex-col">

    <!-- TOP NAVIGATION -->
    <nav class="bg-white border-b sticky top-0 z-50 px-6 py-4 md:px-24 flex items-center justify-between">
        <div class="flex items-center gap-4 cursor-pointer" onclick="showPage('home')">
            <img src="orus_logo.png" alt="ORUS Logo" class="h-9 w-auto"
                onerror="this.src='https://placehold.co/120x40?text=ORUS'">
        </div>

        <div class="hidden md:flex items-center gap-10 font-bold text-xs uppercase tracking-widest text-slate-800">
            <a href="#" onclick="showPage('home')" class="hover:text-blue-800">Home</a>
            <a href="#" class="hover:text-blue-800">About</a>
            <a href="#" class="hover:text-blue-800">FAQs</a>
            <a href="#" onclick="showPage('flow', 'Digital TIN ID')" class="hover:text-blue-800 text-blue-600">Digital
                TIN ID</a>
            <button
                class="bg-[#03297b] text-white px-8 py-2.5 rounded font-bold uppercase tracking-wider hover:bg-blue-900 transition-all shadow-lg">
                Login
            </button>
        </div>
    </nav>

    <!-- MAIN CONTENT AREA -->
    <div id="page-home" class="active-page page-transition">
        <!-- Hero Section -->
        <section class="hero-bg relative min-h-[550px] flex items-center justify-center text-center px-6">
            <div class="absolute inset-0 bir-gradient-overlay"></div>

            <div class="relative z-10 max-w-4xl pt-10">
                <div class="inline-block border border-white/40 rounded-full px-6 py-2 mb-8 backdrop-blur-sm">
                    <span class="text-white text-[10px] font-bold uppercase tracking-widest">BIR Online Registration and
                        Update System (ORUS)</span>
                </div>

                <h1 class="text-white text-4xl md:text-6xl font-extrabold mb-6 leading-tight tracking-tight">
                    Register or Update Your Tax <br class="hidden md:block"> Information Online
                </h1>

                <p class="text-white/80 text-lg md:text-xl mb-10 max-w-2xl mx-auto font-light leading-relaxed">
                    ORUS 2.0 - A faster, simpler, and more secure way to manage your BIR registration. Complete your
                    application from anywhere, anytime.
                </p>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <button onclick="showPage('flow', 'New Registration')"
                        class="w-full sm:w-auto bg-white text-[#03297b] px-10 py-4 rounded font-bold hover:bg-slate-100 transition-all shadow-xl">
                        Get Started
                    </button>
                    <button
                        class="w-full sm:w-auto bg-[#011a4d] text-white px-10 py-4 rounded font-bold hover:bg-black transition-all border border-white/20">
                        Visit BIR Official Website
                    </button>
                </div>

                <div class="mt-16 flex items-center justify-center gap-12 md:gap-24">
                    <div class="text-center">
                        <div class="text-white text-2xl font-bold">500K+</div>
                        <div class="text-white/50 text-[10px] uppercase font-bold tracking-widest">Registered Users
                        </div>
                    </div>
                    <div class="text-center">
                        <div class="text-white text-2xl font-bold">99.9%</div>
                        <div class="text-white/50 text-[10px] uppercase font-bold tracking-widest">Uptime</div>
                    </div>
                    <div class="text-center">
                        <div class="text-white text-2xl font-bold">24/7</div>
                        <div class="text-white/50 text-[10px] uppercase font-bold tracking-widest">Availability</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Our Services Section -->
        <section class="max-w-7xl mx-auto px-6 py-24">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-black text-[#03297b] mb-4">What would you like to do?</h2>
                <p class="text-slate-500 font-medium">Choose from our quick actions to get started with your tax
                    registration or updates</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Service Cards -->
                <div onclick="showPage('flow', 'New Registration')"
                    class="bg-white p-8 rounded border border-slate-100 card-shadow cursor-pointer group">
                    <div
                        class="w-12 h-12 bg-blue-50 text-blue-900 rounded flex items-center justify-center mb-8 group-hover:bg-blue-900 group-hover:text-white transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">New Registration</h3>
                    <p class="text-xs text-slate-500 mb-6 leading-relaxed italic">Register as a new taxpayer with BIR
                    </p>
                    <span
                        class="text-blue-700 text-[10px] font-black uppercase tracking-widest flex items-center gap-2">Learn
                        more &rarr;</span>
                </div>

                <div onclick="showPage('flow', 'Secondary Registration')"
                    class="bg-white p-8 rounded border border-slate-100 card-shadow cursor-pointer group">
                    <div
                        class="w-12 h-12 bg-blue-50 text-blue-900 rounded flex items-center justify-center mb-8 group-hover:bg-blue-900 group-hover:text-white transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Secondary Registration</h3>
                    <p class="text-xs text-slate-500 mb-6 leading-relaxed italic">Register books, ATP, or branches
                    </p>
                    <span
                        class="text-blue-700 text-[10px] font-black uppercase tracking-widest flex items-center gap-2">Learn
                        more &rarr;</span>
                </div>

                <div onclick="showPage('flow', 'Update Registration')"
                    class="bg-white p-8 rounded border border-slate-100 card-shadow cursor-pointer group">
                    <div
                        class="w-12 h-12 bg-blue-50 text-blue-900 rounded flex items-center justify-center mb-8 group-hover:bg-blue-900 group-hover:text-white transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Update Registration</h3>
                    <p class="text-xs text-slate-500 mb-6 leading-relaxed italic">Modify your taxpayer information</p>
                    <span
                        class="text-blue-700 text-[10px] font-black uppercase tracking-widest flex items-center gap-2">Learn
                        more &rarr;</span>
                </div>

                <div onclick="showPage('flow', 'TIN Verification')"
                    class="bg-white p-8 rounded border border-slate-100 card-shadow cursor-pointer group">
                    <div
                        class="w-12 h-12 bg-blue-50 text-blue-900 rounded flex items-center justify-center mb-8 group-hover:bg-blue-900 group-hover:text-white transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">TIN Verification</h3>
                    <p class="text-xs text-slate-500 mb-6 leading-relaxed italic">Verify your Tax Identification Number
                    </p>
                    <span
                        class="text-blue-700 text-[10px] font-black uppercase tracking-widest flex items-center gap-2">Learn
                        more &rarr;</span>
                </div>
            </div>
            <p class="mt-8 text-center text-[11px] text-slate-400 font-bold uppercase tracking-widest">Need help
                deciding? <a href="#" class="text-[#03297b] border-b border-blue-200">Contact our support team</a></p>
        </section>

        <!-- HOW IT WORKS SECTION -->
        <section class="bg-slate-50 py-24 px-6 md:px-24">
            <div class="max-w-7xl mx-auto">
                <div class="text-center mb-16">
                    <h2 class="text-4xl font-black text-[#1e293b] mb-4">How It Works</h2>
                    <p class="text-slate-500 font-medium">Complete your BIR registration in 4 simple steps</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <!-- Step 01 -->
                    <div class="step-card bg-white p-8 rounded-xl border border-slate-100 shadow-sm">
                        <div
                            class="w-10 h-10 bg-blue-900 text-white rounded flex items-center justify-center font-black mb-6">
                            01</div>
                        <div class="w-12 h-12 bg-slate-50 rounded flex items-center justify-center mb-4 text-slate-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                            </svg>
                        </div>
                        <h4 class="font-black text-[#1e293b] mb-2">Create Account</h4>
                        <p class="text-xs text-slate-400 leading-relaxed">Sign up with your email and create a secure
                            password</p>
                    </div>

                    <!-- Step 02 -->
                    <div class="step-card bg-white p-8 rounded-xl border border-slate-100 shadow-sm">
                        <div
                            class="w-10 h-10 bg-blue-900 text-white rounded flex items-center justify-center font-black mb-6">
                            02</div>
                        <div class="w-12 h-12 bg-slate-50 rounded flex items-center justify-center mb-4 text-slate-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        <h4 class="font-black text-[#1e293b] mb-2">Fill Application</h4>
                        <p class="text-xs text-slate-400 leading-relaxed">Complete your registration form with accurate
                            information</p>
                    </div>

                    <!-- Step 03 -->
                    <div class="step-card bg-white p-8 rounded-xl border border-slate-100 shadow-sm">
                        <div
                            class="w-10 h-10 bg-blue-900 text-white rounded flex items-center justify-center font-black mb-6">
                            03</div>
                        <div class="w-12 h-12 bg-slate-50 rounded flex items-center justify-center mb-4 text-slate-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                            </svg>
                        </div>
                        <h4 class="font-black text-[#1e293b] mb-2">Upload Documents</h4>
                        <p class="text-xs text-slate-400 leading-relaxed">Submit required documents and supporting files
                        </p>
                    </div>

                    <!-- Step 04 -->
                    <div class="step-card bg-white p-8 rounded-xl border border-slate-100 shadow-sm">
                        <div
                            class="w-10 h-10 bg-blue-900 text-white rounded flex items-center justify-center font-black mb-6">
                            04</div>
                        <div class="w-12 h-12 bg-slate-50 rounded flex items-center justify-center mb-4 text-slate-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </div>
                        <h4 class="font-black text-[#1e293b] mb-2">Track Status</h4>
                        <p class="text-xs text-slate-400 leading-relaxed">Monitor your application progress in real-time
                        </p>
                    </div>
                </div>

                <div class="mt-16 flex justify-center">
                    <button
                        class="bg-[#03297b] text-white px-10 py-4 rounded font-bold uppercase tracking-wider text-xs shadow-xl hover:bg-blue-900">
                        Start Your Application Now
                    </button>
                </div>
            </div>
        </section>

        <!-- NEED ASSISTANCE SECTION -->
        <section class="max-w-7xl mx-auto px-6 py-24 md:px-24">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-black text-[#1e293b] mb-4">Need Assistance?</h2>
                <p class="text-slate-500 font-medium">Our support team is here to help you with any questions or
                    concerns</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Assistance Cards -->
                <div class="p-8 border border-slate-100 rounded-xl bg-white shadow-sm flex flex-col items-start">
                    <div class="w-10 h-10 bg-slate-50 rounded flex items-center justify-center mb-6 text-slate-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h4 class="font-black text-slate-900 text-sm mb-2">Help Center</h4>
                    <p class="text-[11px] text-slate-400 mb-6 leading-relaxed">Browse our comprehensive FAQ and guides
                    </p>
                    <a href="#"
                        class="mt-auto text-blue-700 text-[10px] font-black uppercase tracking-widest flex items-center gap-2">Visit
                        Help Center &rarr;</a>
                </div>

                <div class="p-8 border border-slate-100 rounded-xl bg-white shadow-sm flex flex-col items-start">
                    <div class="w-10 h-10 bg-slate-50 rounded flex items-center justify-center mb-6 text-slate-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                    </div>
                    <h4 class="font-black text-slate-900 text-sm mb-2">Call Us</h4>
                    <p class="text-[11px] text-slate-400 mb-6 leading-relaxed">(02) 8538-3200 | Mon-Fri, 8AM-5PM</p>
                    <a href="#"
                        class="mt-auto text-blue-700 text-[10px] font-black uppercase tracking-widest flex items-center gap-2">Call
                        Now &rarr;</a>
                </div>

                <div class="p-8 border border-slate-100 rounded-xl bg-white shadow-sm flex flex-col items-start">
                    <div class="w-10 h-10 bg-slate-50 rounded flex items-center justify-center mb-6 text-slate-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h4 class="font-black text-slate-900 text-sm mb-2">Email Support</h4>
                    <p class="text-[11px] text-slate-400 mb-6 leading-relaxed">orus.support@bir.gov.ph</p>
                    <a href="#"
                        class="mt-auto text-blue-700 text-[10px] font-black uppercase tracking-widest flex items-center gap-2">Send
                        Email &rarr;</a>
                </div>

                <div class="p-8 border border-slate-100 rounded-xl bg-white shadow-sm flex flex-col items-start">
                    <div class="w-10 h-10 bg-slate-50 rounded flex items-center justify-center mb-6 text-slate-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                        </svg>
                    </div>
                    <h4 class="font-black text-slate-900 text-sm mb-2">Live Chat</h4>
                    <p class="text-[11px] text-slate-400 mb-6 leading-relaxed">Chat with our support team</p>
                    <a href="#"
                        class="mt-auto text-blue-700 text-[10px] font-black uppercase tracking-widest flex items-center gap-2">Start
                        Chat &rarr;</a>
                </div>
            </div>

            <!-- Important Notice Banner -->
            <div class="mt-12 bg-[#f0f7ff] border-l-4 border-[#03297b] p-6 rounded-r-lg flex items-start gap-4">
                <div
                    class="w-6 h-6 bg-[#03297b] text-white rounded-full flex items-center justify-center shrink-0 text-[10px] font-bold">
                    i</div>
                <div>
                    <h5 class="font-black text-[#03297b] text-xs uppercase tracking-widest mb-1">Important Notice</h5>
                    <p class="text-[11px] text-[#1e293b] leading-relaxed">
                        BIR will never ask for your password, OTP, or personal information via email or phone call. If
                        you receive suspicious communications claiming to be from BIR, please report it immediately to
                        our helpdesk.
                    </p>
                </div>
            </div>
        </section>
    </div>

    <!-- USER FLOW PAGE -->
    <div id="page-flow" class="hidden-page page-transition flex-grow bg-slate-50">
        <div class="bg-[#03297b] py-16 px-6 md:px-24 text-white">
            <div class="max-w-7xl mx-auto">
                <nav class="text-[10px] font-black tracking-widest mb-6 opacity-60 flex items-center gap-2 uppercase">
                    <span class="cursor-pointer hover:underline" onclick="showPage('home')">Home</span>
                    <span>/</span>
                    <span id="breadcrumb-title">Service</span>
                </nav>
                <h1 id="flow-title" class="text-3xl md:text-5xl font-black mb-4">Service Details</h1>
                <p id="flow-desc" class="text-blue-100 opacity-80 max-w-3xl text-sm md:text-base">Please follow the
                    secure automated steps.</p>
            </div>
        </div>

        <div class="max-w-4xl mx-auto px-6 -mt-10 mb-24">
            <div id="flow-content" class="bg-white rounded shadow-2xl p-10 min-h-[400px]">
                <!-- Dynamic Content Loads Here -->
            </div>
        </div>
    </div>

    <!-- FOOTER (Enhanced to match screenshot) -->
    <footer class="bg-[#011a4d] text-white pt-20 pb-10 px-6 md:px-24">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-5 gap-12 mb-16">
            <div class="md:col-span-1">
                <h3 class="text-lg font-black italic tracking-tighter mb-4">ORUS 2.0</h3>
                <p class="text-[11px] text-white/50 leading-relaxed mb-8">
                    Bureau of Internal Revenue<br>Online Registration and Update System
                </p>
                <div class="flex gap-3">
                    <div
                        class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-[10px] hover:bg-white/20 transition-colors">
                        FB</div>
                    <div
                        class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-[10px] hover:bg-white/20 transition-colors">
                        TW</div>
                    <div
                        class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-[10px] hover:bg-white/20 transition-colors">
                        YT</div>
                </div>
            </div>

            <div>
                <h4 class="text-[10px] font-black uppercase tracking-widest mb-8 text-white/40">Quick Links</h4>
                <ul class="text-[11px] space-y-4 font-bold text-white/70">
                    <li><a href="#" class="hover:text-white">Home</a></li>
                    <li><a href="#" class="hover:text-white">How It Works</a></li>
                    <li><a href="#" class="hover:text-white">Login</a></li>
                    <li><a href="#" class="hover:text-white">Support</a></li>
                </ul>
            </div>

            <div>
                <h4 class="text-[10px] font-black uppercase tracking-widest mb-8 text-white/40">Services</h4>
                <ul class="text-[11px] space-y-4 font-bold text-white/70">
                    <li><a href="#" class="hover:text-white">New Registration</a></li>
                    <li><a href="#" class="hover:text-white">Secondary Registration</a></li>
                    <li><a href="#" class="hover:text-white">Update Registration</a></li>
                    <li><a href="#" class="hover:text-white">TIN Verification</a></li>
                </ul>
            </div>

            <div>
                <h4 class="text-[10px] font-black uppercase tracking-widest mb-8 text-white/40">Resources</h4>
                <ul class="text-[11px] space-y-4 font-bold text-white/70">
                    <li><a href="#" class="hover:text-white">User Guide</a></li>
                    <li><a href="#" class="hover:text-white">FAQs</a></li>
                    <li><a href="#" class="hover:text-white">Download Forms</a></li>
                    <li><a href="#" class="hover:text-white">System Requirements</a></li>
                </ul>
            </div>

            <div>
                <h4 class="text-[10px] font-black uppercase tracking-widest mb-8 text-white/40">Legal</h4>
                <ul class="text-[11px] space-y-4 font-bold text-white/70">
                    <li><a href="#" class="hover:text-white">Privacy Policy</a></li>
                    <li><a href="#" class="hover:text-white">Terms of Service</a></li>
                    <li><a href="#" class="hover:text-white">Data Protection</a></li>
                    <li><a href="#" class="hover:text-white">Accessibility</a></li>
                </ul>
            </div>
        </div>

        <!-- Bottom Links Bar -->
        <div
            class="max-w-7xl mx-auto pt-8 border-t border-white/5 flex flex-col md:flex-row justify-center items-center gap-6">
            <div
                class="text-[9px] font-black uppercase tracking-[0.2em] text-white/40 flex flex-wrap justify-center gap-6">
                <span>Government Links:</span>
                <a href="#" class="hover:text-white">BIR Official Website</a>
                <a href="#" class="hover:text-white">Department of Finance</a>
                <a href="#" class="hover:text-white">Official Gazette</a>
                <a href="#" class="hover:text-white">Gov.ph Portal</a>
            </div>
        </div>

        <div class="max-w-7xl mx-auto mt-12 text-center">
            <p class="text-[9px] text-white/20 uppercase font-black tracking-widest">
                © 2024 Bureau of Internal Revenue. All rights reserved. <span class="mx-4">|</span> Republic of the
                Philippines
            </p>
            <p class="text-[8px] text-white/10 uppercase mt-2">This is an official government website of the Bureau of
                Internal Revenue</p>
        </div>
    </footer>

    <script>
        function showPage(pageId, title = '') {
            const home = document.getElementById('page-home');
            const flow = document.getElementById('page-flow');

            home.classList.add('hidden-page');
            home.classList.remove('active-page');
            flow.classList.add('hidden-page');
            flow.classList.remove('active-page');

            setTimeout(() => {
                if (pageId === 'home') {
                    home.classList.remove('hidden-page');
                    home.classList.add('active-page');
                } else if (pageId === 'flow') {
                    document.getElementById('flow-title').innerText = title;
                    document.getElementById('breadcrumb-title').innerText = title;
                    loadFlowLogic(title);
                    flow.classList.remove('hidden-page');
                    flow.classList.add('active-page');
                }
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }, 50);
        }

        function loadFlowLogic(type) {
            const container = document.getElementById('flow-content');
            const desc = document.getElementById('flow-desc');

            if (type === 'New Registration') {
                desc.innerText = "Application for Taxpayer Identification Number (TIN).";
                container.innerHTML = `
                    <div class="space-y-10">
                        <div class="flex items-center gap-6 border-b pb-8">
                            <div class="w-14 h-14 bg-blue-900 text-white rounded flex items-center justify-center font-black text-xl">1</div>
                            <div>
                                <h3 class="text-lg font-bold">Select Taxpayer Category</h3>
                                <p class="text-xs text-slate-500">Choose the registration type that applies to you.</p>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="border-2 border-blue-700 bg-blue-50 p-8 rounded cursor-pointer relative shadow-sm">
                                <span class="absolute top-4 right-4 text-blue-700"><svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg></span>
                                <h4 class="font-bold text-blue-900 mb-2">Individual</h4>
                                <p class="text-xs text-blue-700">Self-employed, Professionals, or Employees.</p>
                            </div>
                            <div class="border-2 border-slate-100 p-8 rounded cursor-pointer hover:border-blue-200 shadow-sm transition-all">
                                <h4 class="font-bold text-slate-900 mb-2">Non-Individual</h4>
                                <p class="text-xs text-slate-500">Corporations, Partnerships, or Organizations.</p>
                            </div>
                        </div>
                        <button class="w-full bg-[#03297b] text-white py-4 rounded font-bold uppercase tracking-widest text-xs hover:bg-blue-900">Proceed to Application</button>
                    </div>`;
            } else if (type === 'TIN Verification') {
                desc.innerText = "Check your registration status or verify a TIN.";
                container.innerHTML = `
                    <div class="max-w-lg mx-auto py-10">
                        <h3 class="text-xl font-black text-center mb-8">TIN Inquiry Portal</h3>
                        <div class="space-y-6">
                            <div>
                                <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 block mb-2">Enter TIN</label>
                                <input type="text" placeholder="000-000-000-000" class="w-full border-2 border-slate-100 px-6 py-4 rounded focus:border-blue-700 outline-none font-bold tracking-widest">
                            </div>
                            <button class="w-full bg-[#03297b] text-white py-4 rounded font-bold uppercase tracking-widest text-xs">Verify Registration</button>
                        </div>
                        <p class="text-center text-[10px] mt-8 text-slate-400">Your information is protected under the Data Privacy Act of 2012.</p>
                    </div>`;
            } else if (type === 'Update Registration') {
                desc.innerText = "Update your existing BIR records securely.";
                container.innerHTML = `
                    <div class="space-y-8">
                        <div class="bg-yellow-50 border-l-4 border-yellow-400 p-6 rounded">
                            <p class="text-xs text-yellow-800 font-bold italic">Note: You must have an active ORUS account to update your profile online.</p>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="p-6 border rounded hover:shadow-md cursor-pointer transition-all">
                                <h4 class="font-bold mb-2">Change Contact Details</h4>
                                <p class="text-xs text-slate-500">Email, Phone, or Emergency contacts.</p>
                            </div>
                            <div class="p-6 border rounded hover:shadow-md cursor-pointer transition-all">
                                <h4 class="font-bold mb-2">Add/Update Business Activity</h4>
                                <p class="text-xs text-slate-500">Register new branch or change line of business.</p>
                            </div>
                        </div>
                    </div>`;
            } else if (type === 'Secondary Registration') {
                desc.innerText = "Apply for ATP, register Books of Accounts, or Permits to Use (PTU).";
                container.innerHTML = `
                    <div class="space-y-8">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="p-6 border rounded hover:shadow-md cursor-pointer transition-all">
                                <h4 class="font-bold mb-2">Authority to Print (ATP)</h4>
                                <p class="text-xs text-slate-500">Apply to print receipts and invoices.</p>
                            </div>
                            <div class="p-6 border rounded hover:shadow-md cursor-pointer transition-all">
                                <h4 class="font-bold mb-2">Books of Accounts</h4>
                                <p class="text-xs text-slate-500">Register manual or computerized books.</p>
                            </div>
                            <div class="p-6 border rounded hover:shadow-md cursor-pointer transition-all">
                                <h4 class="font-bold mb-2">Permit to Use (PTU)</h4>
                                <p class="text-xs text-slate-500">For CRM/POS machines or computerized accounting.</p>
                            </div>
                        </div>
                    </div>`;
            } else if (type === 'Digital TIN ID') {
                desc.innerText = "Generate your official digital TIN ID card.";
                container.innerHTML = `<div class="flex flex-col items-center py-10">
                    <div class="w-full max-w-sm bg-blue-900 rounded-xl p-6 text-white mb-10 shadow-2xl relative overflow-hidden">
                        <div class="flex justify-between items-start mb-6">
                            <div class="text-[8px] font-black leading-tight uppercase">Bureau of Internal Revenue<br>Digital TIN ID</div>
                            <div class="text-[8px] font-bold opacity-50">ORUS 2.0</div>
                        </div>
                        <div class="flex gap-4 mb-6">
                            <div class="w-20 h-24 bg-white/10 rounded border border-white/20"></div>
                            <div>
                                <div class="text-[10px] font-bold mb-2">DELA CRUZ, JUAN P.</div>
                                <div class="text-lg font-black tracking-widest">123-456-789</div>
                            </div>
                        </div>
                        <div class="text-[7px] text-white/40">Verified On: 20 FEB 2024</div>
                    </div>
                    <button class="bg-[#03297b] text-white px-12 py-3 rounded font-bold uppercase tracking-widest text-xs">Download Digital ID</button>
                </div>`;
            }
        }
    </script>
</body>

</html>
